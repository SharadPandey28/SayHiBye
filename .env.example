# ─── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── MongoDB Atlas ──────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/dhsecurechat

# ─── Upstash Redis ──────────────────────────────────────────────
# Get this from: https://console.upstash.com → Create Database → .env tab
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:yourpassword@us1-xxxx.upstash.io:6379

# ─── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# ─── Admin ─────────────────────────────────────────────────────
# Password for the auto-created admin account on first run
ADMIN_PASSWORD=change_this_strong_password

# ─── CORS ──────────────────────────────────────────────────────
# Your production frontend URL (Cloudflare Pages URL or custom domain)
# In dev: http://localhost:3001
ALLOWED_ORIGIN=http://localhost:3001
